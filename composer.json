{
  "name": "cgoit/contao-folder-gallery-bundle",
  "description": "A Contao CMS extension for creating folder-based image galleries with YAML metadata, responsive images, gallery overviews and customizable frontend templates.",
  "license": "LGPL-3.0-or-later",
  "type": "contao-bundle",
  "version": "0.1.0",
  "authors": [
    {
      "name": "Carsten Götzinger",
      "homepage": "https://github.com/cgoIT"
    }
  ],
  "homepage": "https://github.com/cgoIT",
  "support": {
    "issues": "https://github.com/cgoIT/contao-folder-gallery-bundle/issues",
    "source": "https://github.com/cgoIT/contao-folder-gallery-bundle"
  },
  "require": {
    "php": "^8.3",
    "contao/core-bundle": "^5.3",
    "contao/image": "^1.2",
    "symfony/config": "^6.0 || ^7.3",
    "symfony/dependency-injection": "^6.0 || ^7.3",
    "symfony/http-foundation": "^6.0 || ^7.3",
    "symfony/http-kernel": "^6.0 || ^7.3",
    "symfony/filesystem": "^6.0 || ^7.3",
    "symfony/security-bundle": "^6.0 || ^7.3",
    "symfony/yaml": "^6.0 || ^7.3",
    "twig/twig": "^3"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.0",
    "terminal42/contao-build-tools": "dev-main",
    "phpunit/phpunit": "^12.5 || ^13.2"
  },
  "conflict": {
    "contao/manager-plugin": "<2.0 || >= 3.0"
  },
  "autoload": {
    "psr-4": {
      "Cgoit\\ContaoFolderGalleryBundle\\": "src/",
      "Cgoit\\ContaoFolderGalleryBundle\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "contao-components/installer": true,
      "php-http/discovery": true,
      "contao/manager-plugin": true,
      "terminal42/contao-build-tools": true
    }
  },
  "extra": {
    "contao-manager-plugin": "Cgoit\\ContaoFolderGalleryBundle\\ContaoManager\\Plugin"
  },
  "scripts": {
    "phpunit": "vendor/bin/phpunit",
    "unit-tests": "@phpunit",
    "all": [
      "@ecs",
      "@rector",
      "@phpstan",
      "@twig-cs-fixer",
      "@yamllint",
      "@depcheck",
      "@phpunit"
    ]
  }
}
