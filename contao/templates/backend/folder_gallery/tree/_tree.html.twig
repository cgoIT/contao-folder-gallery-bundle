{% import '@Contao/backend/folder_gallery/_macros.html.twig' as gallery %}

{% macro folder_node(folder) %}
<li>
    {% set icon_map = {
        gallery: 'image.svg',
        group: 'parent.svg',
        hidden: 'invisible.svg',
    } %}

    {% set folder_link_attributes = attrs()
        .addClass('node')
        .addClass(folder.isPublished ? 'node--published' : 'node--unpublished')
        .addClass('node--' ~ folder.overviewMode.value)
        .set('href', path('cgoit_folder_gallery', {path: folder.path}))
    %}
    <a{{ folder_link_attributes }}>
        <span class="node__icon">
            {{ gallery.icon(folder.overviewMode.value) }}
        </span>

        <span class="node__label">
            {{ folder.title }}
        </span>
    </a>

    {% if folder.folders %}
        <ol>
            {% for child in folder.folders %}
                {{ _self.folder_node(child) }}
            {% endfor %}
        </ol>
    {% endif %}
</li>
{% endmacro %}

<nav>
{% for folder in folders %}
    <ol>
        {{ _self.folder_node(folder) }}
    </ol>
{% endfor %}
</nav>
