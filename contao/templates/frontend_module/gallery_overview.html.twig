{% extends '@Contao/frontend_module/_base.html.twig' %}
{% use '@Contao/component/_figure.html.twig' %}

{% block content %}
    {% for year in overview.years %}
        <h2>{{ year.title }}</h2>

        <ul>
            {% for day in year.days %}
                <li class="module-gallery-overview__days">
                    <div>
                        {% if day.coverFigure %}
                            {% with { figure: day.coverFigure } %}
                                {{ block('figure_component') }}
                            {% endwith %}
                        {% endif %}

                        <h3>{{ day.title }}</h3>

                        {% if day.description %}
                            <p>{{ day.description }}</p>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endfor %}
{% endblock %}
