{% extends '@Contao/frontend_module/_base.html.twig' %}

{% block content %}

    {% if content is defined %}
        {{ include(contentTemplate, {
            content,
            contentTemplate,
            folderTemplate,
        }) }}
    {% else %}
        {% for folder in overview.folders %}
            {% if folder.isGallery %}
                <div class="module-gallery-overview__folders">
            {% endif %}

            {{ include(folderTemplate, {
                folderHeadingLevel: 1,
                folder,
                folderTemplate,
            }) }}

            {% if folder.isGallery %}
                </div>
            {% endif %}
        {% endfor %}
    {% endif %}

{% endblock %}
