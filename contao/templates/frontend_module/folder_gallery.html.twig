{% extends '@Contao/frontend_module/_base.html.twig' %}

{% block content %}

    {% if content is defined %}
        {{ include(contentTemplate, {
            content,
            contentTemplate,
            folderTemplate,
        }) }}
    {% else %}
        {% if overview.introText is not empty %}
            <div class="module-gallery-overview__intro">
                {{ overview.introText|sanitize_html('contao')|csp_inline_styles|encode_email|insert_tag_raw }}
            </div>
        {% endif %}

        {% for folder in overview.folders %}
            {% if folder.isGallery %}
                <div class="module-gallery-overview__folders">
            {% endif %}

            {{ include(folderTemplate, {
                folderHeadingLevel: 1,
                folder,
                folderTemplate,
            }) }}

            {% if folder.isGallery %}
                </div>
            {% endif %}
        {% endfor %}
    {% endif %}

{% endblock %}
