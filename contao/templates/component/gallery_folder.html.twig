{% trans_default_domain 'contao_folder_gallery' %}
{% use '@Contao/component/_figure.html.twig' %}

{% set heading_tag = 'h' ~ min(folder.level + 1, 6) %}

{% if folder.isGroup %}
    <section class="module-gallery-overview__group level-{{ folder.level }}">
        <{{ heading_tag }}
            class="module-gallery-overview__group-title"
            {% if folder.anchor %}
                id="{{ folder.anchor }}"
            {% endif %}
        >
            {{ folder.title }}
        </{{ heading_tag }}>

{#        {% if folder.description %}#}
{#            <div class="module-gallery-overview__description">#}
{#                {{ folder.description|raw }}#}
{#            </div>#}
{#        {% endif %}#}

        <div class="module-gallery-overview__folders">
            {% for child in folder.children %}
                {{ include(folderTemplate, {
                    folder: child,
                    folderTemplate,
                }) }}
            {% endfor %}
        </div>
    </section>
{% else %}
    {% set wrapper_attributes = attrs()
        .addClass('module-gallery-overview__folder')
    %}

    <article{{ wrapper_attributes }}>
        {% if folder.coverFigure %}
            <div class="module-gallery-overview__image">
                {% with {figure: folder.coverFigure} %}
                    {{ block('figure_component') }}
                {% endwith %}
            </div>
        {% endif %}

        <div class="module-gallery-overview__content">
            <h3 class="module-gallery-overview__folder-title">
                <a href="{{ folder.url }}">
                    {{ folder.title }}
                </a>
            </h3>

            <div class="module-gallery-overview__meta">
                {% if folder.imageCount > 0 %}
                    <span class="module-gallery-overview__image-count">
                        {{ folder.imageCount }}
                        {{ folder.imageCount == 1
                            ? 'folder_gallery.image_count.0'|trans
                            : 'folder_gallery.image_count.1'|trans
                        }}
                    </span>
                {% endif %}

                {% if folder.folderCount > 0 %}
                    {% if folder.imageCount > 0 %}
                        <span class="module-gallery-overview__separator">•</span>
                    {% endif %}

                    <span class="module-gallery-overview__folder-count">
                        {{ folder.folderCount }}
                        {{ folder.folderCount == 1
                            ? 'folder_gallery.sub_gallery_count.0'|trans
                            : 'folder_gallery.sub_gallery_count.1'|trans
                        }}
                    </span>
                {% endif %}
            </div>

{#            {% if folder.description %}#}
{#                <div class="module-gallery-overview__description">#}
{#                    {{ folder.description|raw }}#}
{#                </div>#}
{#            {% endif %}#}
        </div>
    </article>
{% endif %}
