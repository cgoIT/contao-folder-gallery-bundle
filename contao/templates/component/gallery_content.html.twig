{% trans_default_domain 'contao_folder_gallery' %}
{% use '@Contao/component/_figure.html.twig' %}

<div class="gallery-content">
    {% block breadcrumbs %}
        {% if content.breadcrumbs %}
            {# Replaces the page-tree-only BreadcrumbList the core breadcrumb module would add: #}
            {# it can't see the virtual folder levels below this page, so ours (page ancestors + #}
            {# folder trail) supersedes it in the JSON-LD graph's default slot for this type. #}
            {% block gallery_breadcrumb_schema_org %}
                {% do add_schema_org(content.getBreadcrumbSchemaOrgData()) %}
            {% endblock %}

            <div class="gallery-content__navigation gallery-content__navigation--top">
                <nav class="gallery-content__breadcrumbs" aria-label="{{ 'folder_gallery.breadcrumbs'|trans }}">
                    <ol>
                        {% for breadcrumb in content.breadcrumbs %}
                            <li>
                                {% if breadcrumb.url %}
                                    <a href="{{ breadcrumb.url }}">
                                        {{ breadcrumb.title }}
                                    </a>
                                {% else %}
                                    <span aria-current="page">
                                        {{ breadcrumb.title }}
                                    </span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ol>
                </nav>
            </div>
        {% endif %}
    {% endblock %}

    {% block title %}
        {% if content.folder.title %}
            <h2>{{ content.folder.title }}</h2>
        {% endif %}
    {% endblock %}

    {% block description %}
        {% if content.folder.description %}
            <div class="gallery-content__description">
                {{ content.folder.description|raw }}
            </div>
        {% endif %}
    {% endblock %}

    {% block actions %}
        {% if content.actions %}
            <div class="gallery-content__actions">
                {% for action in content.actions %}
                    {% block action %}
                        <a
                            href="{{ action.url }}"
                            class="gallery-content__action gallery-content__action--{{ action.type }}"
                            {% if action.target %}target="{{ action.target }}"{% endif %}
                            {% if action.rel %}rel="{{ action.rel }}"{% endif %}
                            {% if action.title %}title="{{ action.title }}"{% endif %}
                        >
                            {% block action_label %}
                                <span class="gallery-content__action-label">{{ action.label }}</span>
                            {% endblock %}
                        </a>
                    {% endblock %}
                {% endfor %}
            </div>
        {% endif %}
    {% endblock %}

    {% block subfolders %}
        {% if content.folder.children %}
            <div class="gallery-content__subfolders">
                {% for folder in content.folder.children %}
                    {{ include(folderTemplate, {
                        folderHeadingLevel: 2,
                        folder,
                        folderTemplate,
                    }) }}
                {% endfor %}
            </div>
        {% endif %}
    {% endblock %}

    {% block images %}
        {% if content.images %}
            {% block gallery_schema_org %}
                {% do add_schema_org(content.getSchemaOrgData()) %}
            {% endblock %}

            {% set images_attributes = attrs().addClass('gallery-content__images') %}
            {% if content.usesPhotoswipe %}
                {% set images_attributes = images_attributes
                    .set('data-photoswipe', 'pswp')
                    .set('data-pswp-close-title', 'folder_gallery.photoswipe_close'|trans)
                    .set('data-pswp-zoom-title', 'folder_gallery.photoswipe_zoom'|trans)
                    .set('data-pswp-arrow-prev-title', 'folder_gallery.photoswipe_previous'|trans)
                    .set('data-pswp-arrow-next-title', 'folder_gallery.photoswipe_next'|trans)
                    .set('data-pswp-error-msg', 'folder_gallery.photoswipe_error'|trans)
                %}
            {% endif %}

            <div{{ images_attributes }}>
                {% for image in content.images %}
                    <div class="gallery-content__image{{ content.isHighlighted(image) ? ' gallery-content__image--highlighted' }}">
                        {% with {figure: image} %}
                            {{ block('figure_component') }}
                        {% endwith %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    {% endblock %}

    {% block empty_message %}
        {% if content.showEmptyMessage %}
            {{ content.emptyMessage|sanitize_html('contao')|csp_inline_styles|encode_email|insert_tag_raw }}
        {% endif %}
    {% endblock %}

    {% block back_navigation %}
        {% if content.backUrl %}
            <div class="gallery-content__navigation gallery-content__navigation--bottom">
                <a class="gallery-content__back" href="{{ content.backUrl }}">
                    ← {{ 'folder_gallery.back'|trans }}
                </a>
            </div>
        {% endif %}
    {% endblock %}
</div>
